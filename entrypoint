#!/bin/bash

set -o pipefail
set -e

# Global settings
SCRIPT=$(readlink -f "${0}")
DIR=$(dirname "${SCRIPT}")
cd "${DIR}" || exit 1

# Configure and activate the virtual environment
python3 -m venv venv
. ./venv/bin/activate

# Try to upgrade pip, but don't fail the script if it can't be upgraded
if ! python3 -m pip install --upgrade pip ; then
  echo "WARNING: failed to upgrade pip; continuing with existing version" >&2
fi

# Install from requirements, if present
if [ -f requirements.txt ] ; then
  python3 -m pip install -r ./requirements.txt
fi

exec python3 -u ./_entrypoint.py "$@"

exit 1
